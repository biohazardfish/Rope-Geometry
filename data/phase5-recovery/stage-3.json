      "id": "locking-core-recovery",
      "diameter": 0.01,
      "source": "references/Documents/09 - The Somerville Bowline - A4 print friendly.pdf",
      "scope": "Isolated doubled locking-core fixture; exterior connector substitutes for the cuff ONLY to keep one physical path. It is not a reconstructed cuff.",
      "assumptions": [
        {
          "id": "embedding",
          "status": "ASSUMED",
          "description": "Loop in local XY with +Z passage normal; its lower root passes beneath its upper root. Dimensions, root sign, limb identity and orientation relative to the target are hypotheses."
        },
        {
          "id": "fixture-connection",
          "status": "ASSUMED",
          "description": "A remote exterior connector joins standing and working portions of each limb. It must be replaced by the unchanged cuff arcs before full acceptance."
        },
        {
          "id": "limb-pairing",
          "status": "ASSUMED",
          "description": "E0 follows limb 0 through the core to one fold, then limb 1 in reverse to E1. No limb exchange inside the fixture."
        }
      ],
      "evidence": [
        {
          "id": "loop",
          "page": 2,
          "state": "OBSERVED",
          "relation": "Standing bundle owns loop after transfer; direct loop formation and first working passage are explicitly described."
        },
        {
          "id": "over-X",
          "page": 2,
          "state": "OBSERVED",
          "relation": "Working bight passes over the X at the base of that loop."
        },
        {
          "id": "under-cuff",
          "page": 2,
          "state": "OBSERVED",
          "relation": "Whole working bight passes beneath the entire cuff."
        },
        {
          "id": "return",
          "page": 3,
          "state": "OBSERVED",
          "relation": "Bight returns through the loop in the same direction as its first passage."
        }
      ]
    },
